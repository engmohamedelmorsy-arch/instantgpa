{
  "name": "instantgpa-current",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:unit": "node --test tests/academic-plan-parser.test.mjs tests/academic-policy.test.mjs tests/academic-profile.test.mjs tests/academic-record.test.mjs tests/academic-state.test.mjs tests/admin-management.test.mjs tests/command-center.test.mjs tests/degree-audit-inference.test.mjs tests/directionality.test.mjs tests/gpa-calculator.test.mjs tests/localization.test.mjs tests/new-template-ocr.test.mjs tests/observability.test.mjs tests/planning.test.mjs tests/platform-expansion.test.mjs tests/prerequisite-policy.test.mjs tests/pro-subscriber.test.mjs tests/seo.test.mjs tests/transcript-bulk-tools.test.mjs tests/ux-accessibility.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .sites-runtime",
    "typecheck": "tsc --noEmit",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "paypal:setup:sandbox": "node scripts/setup-paypal.mjs --environment sandbox",
    "paypal:setup:live": "node scripts/setup-paypal.mjs --environment live --confirm-live"
  },
  "dependencies": {
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "drizzle-orm": "0.45.2",
    "next": "^16.2.11",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "^9.3.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260808.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.11",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "type": "module",
  "displayName": "InstantGPA Current Version"
}
